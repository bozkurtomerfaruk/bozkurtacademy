  "lesson": {
    "title": {
      "tr": "der · die · das: ipuçları ve kullanım",
      "de": "der · die · das: Hinweise und Gebrauch",
      "en": "der · die · das: clues and use"
    },
    "intro": {
      "tr": "Artikeller her zaman tahmin edilemez; ancak bazı kelime sonları güçlü ipuçları verir. İsimleri yine de artikeliyle birlikte öğren.",
      "de": "Artikel sind nicht immer vorhersagbar. Einige Endungen geben aber starke Hinweise.",
      "en": "Articles cannot always be predicted, but some noun endings are useful clues."
    },
    "rules": [
      {
        "label": "-ung / -heit / -keit",
        "text": {
          "tr": "çoğunlukla die",
          "de": "meist die",
          "en": "usually die"
        }
      },
      {
        "label": "-chen / -lein",
        "text": {
          "tr": "her zaman das",
          "de": "immer das",
          "en": "always das"
        }
      },
      {
        "label": "günler / aylar",
        "text": {
          "tr": "çoğunlukla der",
          "de": "meist der",
          "en": "usually der"
        }
      }
    ],
    "examples": [
      "die Wohnung — daire",
      "das Mädchen — kız",
      "der Montag — Pazartesi"
    ],
    "tip": {
      "tr": "İpucunu kullan ama son kararı kelimeyi artikeliyle öğrenerek ver.",
      "de": "Nutze Regeln als Hilfe, lerne das Nomen aber mit Artikel.",
      "en": "Use patterns as clues, but still learn each noun with its article."
    }
  },
