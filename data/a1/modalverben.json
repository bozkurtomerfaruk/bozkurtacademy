{
  "id": "modalverben",
  "level": "A1",
  "title": {
    "tr": "Modalverben – Präsens",
    "de": "Modalverben – Präsens",
    "en": "Modal verbs – present tense"
  },
  "description": {
    "tr": "können, dürfen, wollen, sollen ve müssen fiillerini yalnızca Präsens'te çalış.",
    "de": "Übe können, dürfen, wollen, sollen und müssen ausschließlich im Präsens.",
    "en": "Practise können, dürfen, wollen, sollen and müssen in the present tense only."
  },
  "lesson": {
    "title": {
      "tr": "Modalverben im Präsens",
      "de": "Modalverben im Präsens",
      "en": "Modalverben im Präsens"
    },
    "intro": {
      "tr": "Modalverben bir eyleme yetenek, izin, istek, görev/tavsiye veya zorunluluk anlamı katar. Modal fiil çekimlenir; ana fiil infinitiv olarak cümlenin sonunda kalır.",
      "de": "Modalverben drücken Fähigkeit, Erlaubnis, Wunsch, Auftrag/Rat oder Notwendigkeit aus. Das Modalverb wird konjugiert; das Vollverb steht im Infinitiv am Satzende.",
      "en": "Modal verbs express ability, permission, intention, instruction/advice or necessity. The modal verb is conjugated and the main verb stays in the infinitive at the end."
    },
    "rules": [
      {
        "label": "können",
        "text": {
          "tr": "ich kann · du kannst · er/sie/es kann · wir können · ihr könnt · sie/Sie können",
          "de": "ich kann · du kannst · er/sie/es kann · wir können · ihr könnt · sie/Sie können",
          "en": "ich kann · du kannst · er/sie/es kann · wir können · ihr könnt · sie/Sie können"
        }
      },
      {
        "label": "dürfen",
        "text": {
          "tr": "ich darf · du darfst · er/sie/es darf · wir dürfen · ihr dürft · sie/Sie dürfen",
          "de": "ich darf · du darfst · er/sie/es darf · wir dürfen · ihr dürft · sie/Sie dürfen",
          "en": "ich darf · du darfst · er/sie/es darf · wir dürfen · ihr dürft · sie/Sie dürfen"
        }
      },
      {
        "label": "wollen",
        "text": {
          "tr": "ich will · du willst · er/sie/es will · wir wollen · ihr wollt · sie/Sie wollen",
          "de": "ich will · du willst · er/sie/es will · wir wollen · ihr wollt · sie/Sie wollen",
          "en": "ich will · du willst · er/sie/es will · wir wollen · ihr wollt · sie/Sie wollen"
        }
      },
      {
        "label": "sollen",
        "text": {
          "tr": "ich soll · du sollst · er/sie/es soll · wir sollen · ihr sollt · sie/Sie sollen",
          "de": "ich soll · du sollst · er/sie/es soll · wir sollen · ihr sollt · sie/Sie sollen",
          "en": "ich soll · du sollst · er/sie/es soll · wir sollen · ihr sollt · sie/Sie sollen"
        }
      },
      {
        "label": "müssen",
        "text": {
          "tr": "ich muss · du musst · er/sie/es muss · wir müssen · ihr müsst · sie/Sie müssen",
          "de": "ich muss · du musst · er/sie/es muss · wir müssen · ihr müsst · sie/Sie müssen",
          "en": "ich muss · du musst · er/sie/es muss · wir müssen · ihr müsst · sie/Sie müssen"
        }
      }
    ],
    "examples": [
      "Ich kann heute länger arbeiten. — Bugün daha uzun çalışabilirim.",
      "Darf ich hier sitzen? — Burada oturabilir miyim?",
      "Wir wollen am Samstag einen Tisch reservieren. — Cumartesi bir masa ayırtmak istiyoruz.",
      "Du sollst zuerst den Text lesen. — Önce metni okumalısın.",
      "Ihr müsst die Aufgabe heute machen. — Görevi bugün yapmak zorundasınız."
    ],
    "tip": {
      "tr": "Modalverb çekimli olarak 2. pozisyonda, ana fiil infinitiv olarak sonda: Ich muss heute arbeiten.",
      "de": "Das Modalverb steht konjugiert auf Position 2, das Vollverb im Infinitiv am Satzende.",
      "en": "The modal verb is conjugated in position 2; the main verb goes to the end in the infinitive."
    }
  },
