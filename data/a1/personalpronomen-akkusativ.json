{
  "id": "personalpronomen-akkusativ",
  "level": "A1",
  "title": {
    "tr": "Personalpronomen im Akkusativ",
    "de": "Personalpronomen im Akkusativ",
    "en": "Personal pronouns in the accusative"
  },
  "description": {
    "tr": "Nesneyi tekrar etmek yerine mich, dich, ihn, sie, es, uns, euch ve sie kullan.",
    "de": "Ersetze Akkusativobjekte durch Personalpronomen.",
    "en": "Replace accusative objects with personal pronouns."
  },
  "lesson": {
    "title": {
      "tr": "Akkusativ zamirleri",
      "de": "Personalpronomen im Akkusativ",
      "en": "Accusative pronouns"
    },
    "intro": {
      "tr": "Bir kişi veya şeyi daha önce söylediysek, Akkusativ nesnesini zamirle tekrar edebiliriz.",
      "de": "Bekannte Akkusativobjekte können durch Pronomen ersetzt werden.",
      "en": "Known accusative objects can be replaced with pronouns."
    },
    "rules": [
      {
        "label": "ich → mich",
        "text": {
          "tr": "beni",
          "de": "mich",
          "en": "me"
        }
      },
      {
        "label": "du → dich",
        "text": {
          "tr": "seni",
          "de": "dich",
          "en": "you"
        }
      },
      {
        "label": "er → ihn",
        "text": {
          "tr": "onu (er)",
          "de": "ihn",
          "en": "him"
        }
      },
      {
        "label": "sie → sie",
        "text": {
          "tr": "onu (sie)",
          "de": "sie",
          "en": "her"
        }
      },
      {
        "label": "es → es",
        "text": {
          "tr": "onu (es)",
          "de": "es",
          "en": "it"
        }
      }
    ],
    "examples": [
      "Ich kenne den Mann. → Ich kenne ihn.",
      "Sie ruft Anna an. → Sie ruft sie an."
    ],
    "tip": {
      "tr": "Önce ismin cinsiyetini ve tekil/çoğul olduğunu belirle.",
      "de": "Bestimme zuerst Genus und Numerus.",
      "en": "First identify gender and number."
    }
  },
