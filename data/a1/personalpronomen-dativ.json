          "word": "meine Mutter",
          "sentence": "Meine Mutter versteht die App nicht. Ich helfe ___ bei der Anmeldung.",
          "options": [
            "ihr",
            "sie",
            "ihn"
          ],
          "correct": "ihr",
          "explanations": {
            "tr": "helfen + Dativ; die Mutter → ihr.",
            "de": "helfen + Dativ; die Mutter → ihr.",
            "en": "helfen + Dativ; die Mutter → ihr."
          }
        },
