{
  "id": "personalpronomen-dativ",
  "level": "A1",
  "title": {
    "tr": "Personalpronomen im Dativ",
    "de": "Personalpronomen im Dativ",
    "en": "Personal pronouns in the dative"
  },
  "description": {
    "tr": "mir, dir, ihm, ihr, uns, euch ve ihnen ile Dativ nesnelerini cümle içinde kullan.",
    "de": "Übe Dativpronomen im Satz und im Dialog.",
    "en": "Practise dative pronouns in sentences and dialogues."
  },
  "lesson": {
    "title": {
      "tr": "Dativ zamirleri",
      "de": "Personalpronomen im Dativ",
      "en": "Dative pronouns"
    },
    "intro": {
      "tr": "helfen, danken, gefallen, gehören, schmecken ve zuhören gibi bazı fiiller Dativ ister.",
      "de": "Einige Verben wie helfen, danken, gefallen und gehören verlangen den Dativ.",
      "en": "Some verbs such as helfen, danken, gefallen and gehören take the dative."
    },
    "rules": [
      {
        "label": "ich → mir",
        "text": {
          "tr": "bana",
          "de": "mir",
          "en": "to me"
        }
      },
      {
        "label": "du → dir",
        "text": {
          "tr": "sana",
          "de": "dir",
          "en": "to you"
        }
      },
      {
        "label": "er/es → ihm",
        "text": {
          "tr": "ona",
          "de": "ihm",
          "en": "to him/it"
        }
      },
      {
        "label": "sie → ihr",
        "text": {
          "tr": "ona",
          "de": "ihr",
          "en": "to her"
        }
      },
      {
        "label": "wir → uns",
        "text": {
          "tr": "bize",
          "de": "uns",
          "en": "to us"
        }
      }
    ],
    "examples": [
      "Kannst du mir helfen?",
      "Das Buch gehört ihm."
    ],
    "tip": {
      "tr": "Fiilin hangi hâli istediğini de öğren: helfen + Dativ.",
      "de": "Lerne das Verb zusammen mit seinem Kasus.",
      "en": "Learn each verb together with its case."
    }
  },
  "exercises": [
    {
      "id": "dat-kontext-1",
      "title": {
        "tr": "Übung 1 – Dativ fiilleri bağlamda",
        "de": "Übung 1 – Dativverben im Kontext",
        "en": "Exercise 1 – Dative verbs in context"
