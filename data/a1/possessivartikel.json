{
  "id": "possessivartikel",
  "level": "A1",
  "title": {
    "tr": "Possessivartikel",
    "de": "Possessivartikel",
    "en": "Possessive articles"
  },
  "description": {
    "tr": "mein, dein, sein, ihr, unser, euer ve Ihr biçimlerini Nominativ ve Akkusativ'de aile ve günlük hayat bağlamlarında çalış.",
    "de": "Übe mein, dein, sein, ihr, unser, euer und Ihr im Nominativ und Akkusativ in Familie und Alltag.",
    "en": "Practise mein, dein, sein, ihr, unser, euer and Ihr in nominative and accusative contexts."
  },
  "lesson": {
    "title": {
      "tr": "Possessivartikel – Kimin?",
      "de": "Possessivartikel – Wem gehört etwas?",
      "en": "Possessive articles – whose?"
    },
    "intro": {
      "tr": "Possessivartikel bir şeyin kime ait olduğunu gösterir. Kök, sahip olan kişiye göre seçilir; son ek ise ismin cinsiyetine, çoğul olup olmamasına ve cümledeki görevine göre değişir.",
      "de": "Possessivartikel zeigen Zugehörigkeit. Der Stamm richtet sich nach der Person, die etwas besitzt; die Endung richtet sich nach Genus, Numerus und Kasus des Nomens.",
      "en": "Possessive articles show ownership. The stem depends on the owner; the ending depends on the noun's gender, number and case."
    },
    "rules": [
      {
        "label": "Sahip olan kişi",
        "text": {
          "tr": "ich → mein · du → dein · er → sein · sie (tekil) → ihr · wir → unser · ihr → euer · sie (çoğul) → ihr · Sie → Ihr",
          "de": "ich → mein · du → dein · er → sein · sie → ihr · wir → unser · ihr → euer · sie → ihr · Sie → Ihr",
          "en": "ich → mein · du → dein · er → sein · sie → ihr · wir → unser · ihr → euer · sie → ihr · Sie → Ihr"
        }
      },
      {
        "label": "Nominativ",
        "text": {
          "tr": "Maskulin/nötr çoğu zaman ek almaz: mein Vater, dein Auto. Feminin/çoğul -e alır: meine Mutter, deine Freunde.",
          "de": "Maskulin/Neutrum meist ohne Endung: mein Vater, dein Auto. Feminin/Plural mit -e: meine Mutter, deine Freunde.",
          "en": "Masculine/neuter often have no ending: mein Vater, dein Auto. Feminine/plural take -e: meine Mutter, deine Freunde."
        }
      },
      {
        "label": "Akkusativ",
        "text": {
          "tr": "Maskulin -en alır: meinen Vater, deinen Bruder. Feminin/nötr/çoğul Nominativdeki biçimle aynıdır: meine Tasche, mein Auto, meine Freunde.",
          "de": "Maskulin bekommt -en: meinen Vater, deinen Bruder. Feminin/Neutrum/Plural bleiben wie im Nominativ.",
          "en": "Masculine takes -en: meinen Vater, deinen Bruder. Feminine/neuter/plural stay like the nominative."
        }
      },
      {
        "label": "euer",
        "text": {
          "tr": "euer + son ek geldiğinde çoğu zaman ikinci e düşer: eure Mutter, euren Vater, eure Freunde.",
          "de": "Bei euer fällt vor einer Endung meist das zweite e weg: eure Mutter, euren Vater, eure Freunde.",
          "en": "With euer, the second e usually drops before an ending: eure Mutter, euren Vater, eure Freunde."
        }
      },
      {
        "label": "Ihr / ihr",
        "text": {
          "tr": "Resmî Sie için Possessivartikel büyük harfle Ihr- yazılır: Ihre Tochter. sie için ise küçük harfle ihr-: ihre Tochter.",
          "de": "Bei höflichem Sie schreibt man Ihr- groß: Ihre Tochter. Bei sie schreibt man ihr- klein: ihre Tochter.",
          "en": "Formal Sie uses capital Ihr-: Ihre Tochter. For sie, use lowercase ihr-: ihre Tochter."
        }
      }
    ],
    "examples": [
      "Mein Vater arbeitet in Berlin. — Babam Berlin'de çalışıyor.",
      "Das ist ihre Schwester. — Bu onun kız kardeşi.",
      "Wir besuchen unseren Onkel. — Amcamızı/dayımızı ziyaret ediyoruz.",
      "Sind das eure Freunde? — Bunlar sizin arkadaşlarınız mı?",
      "Wie ist Ihre Adresse? — Adresiniz nedir?"
    ],
    "tip": {
      "tr": "İki adım düşün: 1) Sahip kim? → mein/dein/sein/ihr... 2) İsim hangi biçimde? → mein Vater / meine Mutter / meinen Vater.",
      "de": "Denke in zwei Schritten: 1) Wem gehört es? → mein/dein/sein/ihr... 2) Welche Form braucht das Nomen? → mein Vater / meine Mutter / meinen Vater.",
      "en": "Think in two steps: 1) Who owns it? → mein/dein/sein/ihr... 2) What form does the noun need? → mein Vater / meine Mutter / meinen Vater."
    }
  },
