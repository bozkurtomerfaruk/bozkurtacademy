{
  "id": "sein-haben",
  "level": "A1",
  "title": {
    "tr": "sein & haben",
    "de": "sein & haben",
    "en": "sein & haben"
  },
  "description": {
    "tr": "sein ve haben'ı yalnız çekim olarak değil, günlük kalıplar ve soru cümleleri içinde kullan.",
    "de": "Übe sein und haben in typischen Alltagssätzen und Fragen.",
    "en": "Practise sein and haben in everyday expressions and questions."
  },
  "lesson": {
    "title": {
      "tr": "sein ve haben – Präsens",
      "de": "sein und haben – Präsens",
      "en": "sein and haben – present tense"
    },
    "intro": {
      "tr": "Bu iki fiil düzensizdir ve çok sık kullanılır. Çekimi kadar hangi ifadede hangisinin kullanıldığını da bilmek gerekir.",
      "de": "Beide Verben sind unregelmäßig und sehr häufig. Wichtig ist auch, welches Verb in welcher Wendung steht.",
      "en": "Both verbs are irregular and very common. Learn their forms and typical expressions."
    },
    "rules": [
      {
        "label": "ich",
        "text": {
          "tr": "bin · habe",
          "de": "bin · habe",
          "en": "bin · habe"
        }
      },
      {
        "label": "du",
        "text": {
          "tr": "bist · hast",
          "de": "bist · hast",
          "en": "bist · hast"
        }
      },
      {
        "label": "er/sie/es",
        "text": {
          "tr": "ist · hat",
          "de": "ist · hat",
          "en": "ist · hat"
        }
      },
      {
        "label": "wir",
        "text": {
          "tr": "sind · haben",
          "de": "sind · haben",
          "en": "sind · haben"
        }
      },
      {
        "label": "ihr",
        "text": {
          "tr": "seid · habt",
          "de": "seid · habt",
          "en": "seid · habt"
        }
      }
    ],
    "examples": [
      "Ich bin müde, aber ich habe noch Arbeit.",
      "Habt ihr heute Zeit?",
      "Sind Sie neu hier?"
    ],
    "tip": {
      "tr": "Kalıpları blok halinde öğren: Hunger haben, müde sein, Zeit haben, zu Hause sein.",
      "de": "Lerne feste Wendungen: Hunger haben, müde sein, Zeit haben, zu Hause sein.",
      "en": "Learn common chunks: Hunger haben, müde sein, Zeit haben, zu Hause sein."
    }
  },
