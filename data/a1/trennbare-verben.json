  "id": "trennbare-verben",
  "level": "A1",
  "title": {
    "tr": "Trennbare Verben – Präsens",
    "de": "Trennbare Verben – Präsens",
    "en": "Separable verbs – present tense"
  },
  "description": {
    "tr": "Ayrılabilen fiilleri Präsens'te çek, ön eki doğru yere koy ve günlük cümleler ile sorular kur.",
    "de": "Konjugiere trennbare Verben im Präsens, setze die Vorsilbe an die richtige Stelle und bilde Alltagssätze und Fragen.",
    "en": "Conjugate separable verbs in the present tense, place the prefix correctly and build everyday sentences and questions."
  },
  "lesson": {
    "title": {
      "tr": "Trennbare Verben im Präsens",
      "de": "Trennbare Verben im Präsens",
      "en": "Separable verbs in the present tense"
    },
    "intro": {
      "tr": "Ayrılabilen fiiller bir ön ek ve temel fiilden oluşur. Präsens ana cümlede temel fiil çekimlenir, ayrılan ön ek ise cümlenin sonuna gider.",
      "de": "Trennbare Verben bestehen aus einer Vorsilbe und einem Grundverb. Im Präsens wird das Grundverb konjugiert und die Vorsilbe steht am Satzende.",
      "en": "Separable verbs consist of a prefix and a base verb. In present-tense main clauses, the base verb is conjugated and the prefix goes to the end."
    },
    "rules": [
      {
        "label": "Temel yapı",
        "text": {
          "tr": "anrufen → Ich rufe meine Mutter an.",
          "de": "anrufen → Ich rufe meine Mutter an.",
          "en": "anrufen → Ich rufe meine Mutter an."
        }
      },
      {
        "label": "Soru",
        "text": {
          "tr": "Wann stehst du auf? / Kommst du heute mit?",
          "de": "Wann stehst du auf? / Kommst du heute mit?",
          "en": "Wann stehst du auf? / Kommst du heute mit?"
        }
      },
      {
        "label": "Sık ön ekler",
        "text": {
          "tr": "an-, auf-, aus-, ein-, mit-, ab-, zu-, zurück-, vorbei-, los- gibi birçok ön ek ayrılabilir.",
          "de": "Viele Vorsilben wie an-, auf-, aus-, ein-, mit-, ab-, zu-, zurück-, vorbei- und los- sind trennbar.",
          "en": "Many prefixes such as an-, auf-, aus-, ein-, mit-, ab-, zu-, zurück-, vorbei- and los- are separable."
        }
      },
      {
        "label": "Bu paketin kapsamı",
        "text": {
          "tr": "Bu bölüm yalnızca Präsens ve cümle yapısına odaklanır. Perfekt ve untrennbare Verben ayrı konular olarak ele alınır.",
          "de": "Dieser Abschnitt konzentriert sich nur auf Präsens und Satzstellung. Perfekt und untrennbare Verben werden separat behandelt.",
          "en": "This section focuses only on present tense and word order. Perfect tense and inseparable verbs are handled separately."
        }
      }
    ],
    "examples": [
      "Ich stehe jeden Morgen um sieben Uhr auf. — Her sabah saat yedide kalkıyorum.",
      "Wir kaufen am Samstag ein. — Cumartesi alışveriş yapıyoruz.",
      "Rufst du deine Schwester heute an? — Kız kardeşini bugün arıyor musun?",
      "Der Zug kommt um 18:20 Uhr an. — Tren saat 18.20'de varıyor.",
      "Mach bitte das Fenster zu. — Lütfen pencereyi kapat."
    ],
    "tip": {
      "tr": "Önce fiilin çekimli kısmını bul, sonra ayrılan ön eki cümlenin sonuna gönder: aufstehen → Er steht früh auf.",
      "de": "Finde zuerst den konjugierten Verbteil und setze dann die Vorsilbe ans Satzende: aufstehen → Er steht früh auf.",
      "en": "First conjugate the base verb, then move the prefix to the end: aufstehen → Er steht früh auf."
    }
  },
