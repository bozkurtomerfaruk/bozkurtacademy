  "id": "w-fragen",
  "level": "A1",
  "title": {
    "tr": "W-Fragen",
    "de": "W-Fragen",
    "en": "W-questions"
  },
  "description": {
    "tr": "Wer, was, wo, woher, wohin, wann, wie ve warum gibi temel soru kelimelerini günlük bağlamlarda kullan.",
    "de": "Übe wichtige W-Fragen wie wer, was, wo, woher, wohin, wann, wie und warum.",
    "en": "Practise core W-questions such as wer, was, wo, woher, wohin, wann, wie and warum."
  },
  "lesson": {
    "title": {
      "tr": "W-Fragen – temel soru kelimeleri",
      "de": "W-Fragen – wichtige Fragewörter",
      "en": "W-questions – core question words"
    },
    "intro": {
      "tr": "W-Fragen bilgi almak için kullanılır. Soru kelimesinden sonra çekimli fiil gelir, ardından özne gelir.",
      "de": "W-Fragen benutzt man, wenn man Informationen braucht. Nach dem Fragewort kommt das konjugierte Verb.",
      "en": "W-questions are used to ask for information. The conjugated verb usually comes directly after the question word."
    },
    "rules": [
      {
        "label": "Wer?",
        "text": {
          "tr": "kim? – kişi sorar",
          "de": "wer? – Person",
          "en": "who? – asks about a person"
        }
      },
      {
        "label": "Was?",
        "text": {
          "tr": "ne? – şey / eylem sorar",
          "de": "was? – Sache / Handlung",
          "en": "what? – asks about a thing/action"
        }
      },
      {
        "label": "Wo / Woher / Wohin?",
        "text": {
          "tr": "nerede / nereden / nereye?",
          "de": "wo / woher / wohin?",
          "en": "where / where from / where to?"
        }
      },
      {
        "label": "Wann / Wie / Warum?",
        "text": {
          "tr": "ne zaman / nasıl / neden?",
          "de": "wann / wie / warum?",
          "en": "when / how / why?"
        }
      }
    ],
    "examples": [
      "Wo wohnst du? — Nerede oturuyorsun?",
      "Woher kommst du? — Nereden geliyorsun?",
      "Wohin fährst du morgen? — Yarın nereye gidiyorsun?",
      "Warum lernst du Deutsch? — Neden Almanca öğreniyorsun?"
    ],
    "tip": {
      "tr": "Sorunun cevabına bakarak hangi soru kelimesinin gerektiğini düşün.",
      "de": "Überlege zuerst, welche Information die Antwort gibt.",
      "en": "Look at the type of information in the answer to choose the right question word."
    }
  },
