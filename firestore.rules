rules_version = '2';

// Bozkurt Academy: öğrenci sistemi güvenlik kuralları.
// Firebase yapılandırması herkese açık olduğu için bütün koruma buradadır.
// Kurulum: aşağıdaki teacherUid() içindeki değeri kendi UID'inle değiştir (docs/kurulum.md).
service cloud.firestore {
  match /databases/{database}/documents {

    function teacherUid() {
      return 'IoTwBV5HjRUaoLoj0SCI0VVGkfk2';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.uid == teacherUid();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Hesap açık mı: öğretmen onayı VE (16 yaş ve üstü VEYA veli onayı alınmış).
    function isActive(uid) {
      let p = get(profilePath(uid)).data;
      return p.status == 'active'
        && (p.minor == false || p.get('parentConsent', {}).get('given', false) == true);
    }

    // Öğrenci kendi alt koleksiyonlarını sadece hesabı açıkken okuyabilir.
    function ownActive(uid) {
      return isSelf(uid) && exists(profilePath(uid)) && isActive(uid);
    }

    function validEmail(value) {
      return value is string && value.size() <= 254
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validName(value) {
      return value is string && value.size() >= 2 && value.size() <= 80;
    }

    function validParent(parent, studentEmail) {
      return parent is map
        && parent.keys().hasOnly(['name', 'email'])
        && parent.keys().hasAll(['name', 'email'])
        && validName(parent.name)
        && validEmail(parent.email)
        && parent.email.lower() != studentEmail.lower();
    }

    // Kayıt: öğrenci kendi profilini sadece "onay bekliyor" olarak oluşturabilir.
    // 16 yaş altı: bu yıl − doğum yılı ≤ 16 (güvenli tarafta, docs/plan-ogrenci-sistemi.md 0.1).
    function validNewProfile() {
      let d = request.resource.data;
      let year = request.time.year();
      let provider = request.auth.token.firebase.sign_in_provider;
      let minor = d.birthYear is int && year - d.birthYear <= 16;
      return d.keys().hasOnly(['name', 'email', 'birthYear', 'minor', 'provider', 'status', 'parent', 'emailVerified', 'createdAt'])
        && d.keys().hasAll(['name', 'email', 'birthYear', 'minor', 'provider', 'status', 'createdAt'])
        && validName(d.name)
        && request.auth.token.email is string
        && d.email == request.auth.token.email
        && d.birthYear is int && d.birthYear >= year - 100 && d.birthYear <= year - 5
        && d.minor == minor
        && provider in ['password', 'google.com']
        && d.provider == provider
        && d.status == 'pending'
        && d.createdAt == request.time
        && (!('emailVerified' in d) || verifiedFlag(d.emailVerified))
        && (
          (minor && provider == 'password' && ('parent' in d) && validParent(d.parent, d.email))
          || (!minor && !('parent' in d))
        );
    }

    // "E-posta doğrulandı" bilgisi sadece giriş bilgisi bunu doğruluyorsa yazılabilir.
    function verifiedFlag(value) {
      return value == true && request.auth.token.email_verified == true;
    }

    function validResult() {
      let d = request.resource.data;
      return d.keys().hasOnly(['level', 'topic', 'exercise', 'score', 'total', 'at'])
        && d.keys().hasAll(['level', 'topic', 'exercise', 'score', 'total', 'at'])
        && d.level is string && d.level.matches('^[A-C][12]$')
        && d.topic is string && d.topic.matches('^[a-z0-9-]{1,60}$')
        && d.exercise is string && d.exercise.matches('^[a-z0-9-]{1,60}$')
        && d.total is int && d.total >= 1 && d.total <= 200
        && d.score is int && d.score >= 0 && d.score <= d.total
        && d.at == request.time;
    }

    // Öğrencinin ödeve eklediği kendi dokümanı: sadece Google Docs / Drive linki.
    function validStudentDoc(value) {
      return value is string
        && (value == '' || (value.size() <= 500 && value.matches('^https://(docs|drive)[.]google[.]com/.*')));
    }

    // Ödevde öğrencinin değiştirebildikleri: "tamamladım", tamamlama zamanı ve kendi doküman linki.
    // Tamamlarken zaman sunucu saati olmak zorunda; geri alınca boşaltılır.
    function validAssignmentUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['done', 'doneAt', 'studentDocUrl'])
        && d.done is bool
        && (
          !changed.hasAny(['done', 'doneAt'])
          || (d.done == true && d.doneAt == request.time)
          || (d.done == false && d.doneAt == null)
        )
        && validStudentDoc(d.get('studentDocUrl', ''));
    }

    // Öğretmen her şeyi okuyup yazabilir (öğrenci listesi, onay, ödevler, kaynaklar, silme).
    match /{document=**} {
      allow read, write: if isTeacher();
    }

    match /users/{uid} {
      // Kendi profil belgesi: "onay bekleniyor" ekranı için onaysızken de okunabilir.
      allow get: if isSelf(uid);
      // Silinmiş hesap yeniden profil açamaz.
      allow create: if isSelf(uid)
        && !exists(/databases/$(database)/documents/deleted/$(uid))
        && validNewProfile();
      // Öğrenci kendi profilinde sadece "e-posta doğrulandı" bilgisini ekleyebilir (Firebase
      // e-posta doğrulamasından sonra). Diğer güncellemeler ve silme: sadece öğretmen.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified'])
        && verifiedFlag(request.resource.data.emailVerified);

      match /results/{resultId} {
        allow read: if ownActive(uid);
        // Sadece eklenebilir; düzenleme ve silme yok.
        allow create: if ownActive(uid) && validResult();
      }

      match /assignments/{assignmentId} {
        allow read: if ownActive(uid);
        allow update: if ownActive(uid) && validAssignmentUpdate();
      }

      match /resources/{resourceId} {
        allow read: if ownActive(uid);
      }

      match /lessons/{lessonId} {
        allow read: if ownActive(uid);
      }
    }

    // deleted/{uid}: sadece öğretmen (genel kural). Öğrenci okuyamaz.

    // Seviye testi sonuçları (#seviye-testi). Herkes (anonim giriş dahil) yalnızca yeni sonuç
    // ekleyebilir; okuma, güncelleme ve silme sadece öğretmen (yukarıdaki genel kural).
    // Bekleme süresi: aynı batch içinde placementLimits/{uid} belgesi bu sonucun kimliğiyle
    // yazılmak zorunda; o belge en fazla 10 dakikada bir güncellenebilir.
    function placementLimitPath(uid) {
      return /databases/$(database)/documents/placementLimits/$(uid);
    }

    function validLevel(value) {
      return value in ['A0', 'A1', 'A2', 'B1', 'B2', 'C1'];
    }

    function validBlock(block) {
      return block == null || (block is map
        && block.keys().hasOnly(['correct', 'total'])
        && block.keys().hasAll(['correct', 'total'])
        && block.total is int && block.total >= 1 && block.total <= 20
        && block.correct is int && block.correct >= 0 && block.correct <= block.total);
    }

    function validBlocks(b) {
      return b is map && b.keys().hasOnly(['A1', 'A2', 'B1', 'B2', 'C1'])
        && validBlock(b.get('A1', null)) && validBlock(b.get('A2', null)) && validBlock(b.get('B1', null))
        && validBlock(b.get('B2', null)) && validBlock(b.get('C1', null));
    }

    function shortText(value, max) {
      return value is string && value.size() <= max;
    }

    function validPlacement(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'email', 'goal', 'examName', 'examDate', 'experience', 'note',
          'level', 'near', 'skipped', 'blocks', 'topicErrors', 'wrong', 'writing', 'durationSec', 'bank',
          'lang', 'consent', 'read', 'createdAt', 'expireAt'])
        && d.keys().hasAll(['uid', 'name', 'email', 'goal', 'examName', 'examDate', 'experience', 'note',
          'level', 'near', 'skipped', 'blocks', 'topicErrors', 'wrong', 'writing', 'durationSec', 'bank',
          'lang', 'consent', 'read', 'createdAt', 'expireAt'])
        && d.uid == request.auth.uid
        && validName(d.name)
        && validEmail(d.email)
        && d.goal in ['daily', 'exam', 'work', 'school', 'other']
        && shortText(d.examName, 80)
        && d.examDate is string && (d.examDate == '' || d.examDate.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'))
        && d.experience in ['none', 'lt6m', '6to12m', '1to2y', 'gt2y']
        && shortText(d.note, 1000)
        && validLevel(d.level)
        && (d.near == '' || validLevel(d.near))
        && d.skipped is bool
        && validBlocks(d.blocks)
        // Konu bazında hatalar: "artikel:2,perfekt:1"
        && shortText(d.topicErrors, 1500) && d.topicErrors.matches('^([a-z0-9-]{1,40}:[0-9]{1,2}(,|$))*$')
        // Yanlış cevaplar: her satır "soru-kimliği<TAB>öğrencinin cevabı"
        && shortText(d.wrong, 8000) && d.wrong.matches('^([a-z0-9-]{1,40}\\t[^\\t\\n]{1,200}(\\n|$))*$')
        && shortText(d.writing, 3000)
        && d.durationSec is int && d.durationSec >= 0 && d.durationSec <= 21600
        && d.bank is int && d.bank >= 1 && d.bank <= 100
        && d.lang in ['tr', 'de', 'en']
        && d.consent == true
        && d.read == false
        && d.createdAt == request.time
        // TTL (Firestore → Time-to-live, alan: expireAt): oluşturulduktan 183 gün (6 ay) sonra.
        // Tarayıcı sunucu saatini bilemediği için ±1 gün saat farkı kabul edilir.
        && d.expireAt is timestamp
        && d.expireAt >= request.time + duration.value(182, 'd')
        && d.expireAt <= request.time + duration.value(184, 'd')
        && getAfter(placementLimitPath(request.auth.uid)).data.lastAt == request.time
        && getAfter(placementLimitPath(request.auth.uid)).data.lastId == id;
    }

    function validPlacementLimit() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lastAt', 'lastId'])
        && d.lastAt == request.time
        && d.lastId is string && d.lastId.matches('^[A-Za-z0-9]{10,40}$')
        && existsAfter(/databases/$(database)/documents/placementTests/$(d.lastId));
    }

    match /placementTests/{id} {
      allow create: if signedIn() && validPlacement(id);
    }

    match /placementLimits/{uid} {
      allow create: if isSelf(uid) && validPlacementLimit();
      allow update: if isSelf(uid) && validPlacementLimit()
        && request.time >= resource.data.lastAt + duration.value(10, 'm');
    }
  }
}
