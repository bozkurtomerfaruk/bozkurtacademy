{
  "name": "bozkurtacademy",
  "private": true,
  "description": "Site needs no build. These packages only run the Firestore rule tests and the local emulator.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-bozkurtacademy \"node --test tests/firestore.rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-bozkurtacademy"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
