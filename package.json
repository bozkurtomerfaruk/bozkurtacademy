{
  "name": "bozkurtacademy",
  "private": true,
  "description": "Site needs no build. These packages only run the Firestore rule tests, the Apps Script tests, the placement test browser tests, the placement cleanup job and the local emulator.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-bozkurtacademy \"node --test tests/firestore.rules.test.mjs tests/apps-script.test.mjs tests/worker.test.mjs tests/html.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-bozkurtacademy",
    "test:apps-script": "node --test tests/apps-script.test.mjs",
    "test:cleanup": "firebase emulators:exec --only auth,firestore --project demo-bozkurtacademy \"node tests/placement-cleanup.mjs\"",
    "test:level-exam": "firebase emulators:exec --only auth,firestore --project demo-bozkurtacademy \"node tests/level-exam-account.mjs\"",
    "test:placement": "firebase emulators:exec --only auth,firestore --project demo-bozkurtacademy \"node tests/seviye-testi/placement.mjs\"",
    "test:csp": "firebase emulators:exec --only auth,firestore --project demo-bozkurtacademy \"node tests/csp.mjs\"",
    "test:schreiben": "firebase emulators:exec --only auth,firestore --project demo-bozkurtacademy \"node tests/schreiben-account.mjs\"",
    "test:worker": "node --test tests/worker.test.mjs",
    "test:schreiben-ai": "firebase emulators:exec --only auth,firestore --project demo-bozkurtacademy \"node tests/schreiben-ai-account.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
